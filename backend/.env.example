# ============================================================
# Fingerspot Web — Backend configuration
# Copy this file to ".env" and fill in real values.
# ============================================================

# --- Server ---
PORT=4000

# --- Primary datastore: Google Sheets (via Google Apps Script proxy) ---
# Deploy integrations/google-apps-script.gs as a Web App, then paste the URL.
GAS_URL=
# Must match the AUTH_TOKEN you set inside the Apps Script (Script properties).
GAS_TOKEN=

# --- Backup datastore: MySQL ---
# Every 12h the cron job pulls all rows from Sheets and upserts them here.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=fingerspot_backup
# Hour/minute the daily sync also fires (cron also runs every 12h regardless).
SYNC_CRON_1=0 0 * * * *
SYNC_CRON_2=0 0 12 * * *

# --- Device (Revo W-230N / LAN attendance machines) ---
# We auto-discover devices on the LAN; these are fallbacks / manual overrides.
DEVICE_SIMULATE=false
DEVICE_DISCOVERY_PORTS=5005,4370,80,8080
DEVICE_DISCOVERY_TIMEOUT=600

# --- AI Agent (OpenAI-compatible endpoint, e.g. Groq) ---
AI_ENABLED=true
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
# How many recent attendance/employee rows to feed the model as context.
AI_CONTEXT_ROWS=200
